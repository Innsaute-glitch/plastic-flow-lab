# Only needed when config/llm.json -> "provider": "anthropic-api".
# The default provider "claude-cli" uses your logged-in Claude Code subscription (no key needed).
ANTHROPIC_API_KEY=

# Optional: override the provider from config/llm.json ("claude-cli" | "anthropic-api")
# LLM_PROVIDER=

# Port for the production server (npm start)
PORT=8787
